{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Chatterino+",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://chat.eblo.id/",
  "default_locale": "ru",
  "version": "2.4.0",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "bg.js"
    ]
  },
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "identity",
    "scripting"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://kick.com/*"
  ],
  "host_permissions": [
    "https://*.twitch.tv/*",
    "https://ws.chat.eblo.id/*",
    "https://ws.rish098.xyz/*",
    "https://chat.eblo.id/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.twitch.tv/*"
      ],
      "exclude_matches": [
        "https://api.twitch.tv/*",
        "https://gql.twitch.tv/*",
        "https://passport.twitch.tv/*",
        "https://id.twitch.tv/*",
        "https://player.twitch.tv/*",
        "https://supervisor.ext-twitch.tv/*"
      ],
      "js": [
        "iso.js"
      ],
      "css": [
        "page.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.twitch.tv/*"
      ],
      "exclude_matches": [
        "https://api.twitch.tv/*",
        "https://gql.twitch.tv/*",
        "https://passport.twitch.tv/*",
        "https://id.twitch.tv/*",
        "https://player.twitch.tv/*",
        "https://supervisor.ext-twitch.tv/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://player.twitch.tv/*"
      ],
      "js": [
        "iso.js"
      ],
      "css": [
        "page.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://player.twitch.tv/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chat.eblo.id/chat/give/*",
        "https://ws.chat.eblo.id/chat/give/*",
        "https://ws.rish098.xyz/chat/give/*"
      ],
      "js": [
        "give.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "img/*",
        "ui.css",
        "page.css",
        "pages/options.html",
        "pages/eblo_upload.html"
      ],
      "matches": [
        "https://*.twitch.tv/*"
      ]
    },
    {
      "resources": [
        "icons/*",
        "img/*",
        "ui.css",
        "kick.css",
        "pages/options.html"
      ],
      "matches": [
        "https://kick.com/*"
      ]
    }
  ],
  "page_action": {
    "default_icon": {
      "16": "icons/kick-16.png",
      "32": "icons/kick-32.png"
    },
    "default_title": "__MSG_kickHintTitle__",
    "default_popup": "pages/popup.html",
    "show_matches": [
      "https://kick.com/*"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chatterino-plus@eblo.id",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ],
        "optional": [
          "personallyIdentifyingInfo",
          "authenticationInfo",
          "websiteActivity",
          "websiteContent"
        ]
      }
    }
  }
}