<?xml version="1.0" encoding="utf-8"?>
<!-- Splash Screen for kTube by kipsway -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ktube_bg_onyx"
    android:gravity="center">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Logo Icon -->
        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="kTube Logo" />

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="kTube"
            android:textColor="@color/ktube_text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02"
            android:layout_marginTop="16dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="by kipsway"
            android:textColor="@color/ktube_lavender_accent"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Bottom Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="32dp"
        android:text="Сетевое ядро k-Tunnel • Без рекламы"
        android:textColor="@color/ktube_text_faint"
        android:textSize="12sp" />

</RelativeLayout>
